{
  "serial_port": "/dev/ttyUSB0",
  "baud_rate": 921600,
  "sample_rate_hz": 100,
  "duration_seconds": 3,
  "output_csv": "capture.csv",
  "ack_timeout_seconds": 2,
  "max_frame_bytes": 256,
  "variables": [
    {
      "name": "loop_time_us",
      "address": "0x24000100",
      "type": "uint32"
    },
    {
      "name": "setpoint",
      "address": "0x24000104",
      "type": "float32"
    }
  ]
}
